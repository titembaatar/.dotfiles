#!/usr/bin/env bash

RED="\033[31m"
GRE="\033[32m"
YEL="\033[33m"
BLU="\033[34m"
MAG="\033[35m"
NOC="\033[0m"

DISTRO=""
INSTALL_CMD=""
UPDATE_CMD=""
AI=""

DOTFILES_DIR="$HOME/.dotfiles"
ENV_DIR="$DOTFILES_DIR/env"
LISTS_DIR="$DOTFILES_DIR/runs/lists"

hostname=""
gpu=""
git_user_name=""
git_user_email=""

log() {
	level=$1
	msg=$2
	date=$(date +"%F %T")
	case "${level,,}" in
		error | err)
			printf "[%s] [$RED\0ERROR$NOC\0] %s\n" "$date" "$msg"
			;;
		warning | war)
			printf "[%s] [$YEL\0WARN $NOC\0] %s\n" "$date" "$msg"
			;;
		info | inf)
			printf "[%s] [$BLU\0INFO $NOC\0] %s\n" "$date" "$msg"
			;;
		success | suc)
			printf "[%s] [$GRE\0YATA!$NOC\0] %s\n" "$date" "$msg"
			;;
	esac
}

get_var() {
	log inf "Setup variables"
	while [[ -z $hostname ]]; do
		read -rp "Enter $MAG\0hostname$NOC\0: " hostname
	done

	until [[ $gpu == 'nvidia' || $gpu == 'amd' ]]; do
		read -rp "Enter $MAG\0gpu$NOC\0: [nvidia/amd] " gpu

		if [[ "$gpu" != "nvidia" && "$gpu" != "amd" ]]; then
			log err "$MAG$gpu$NOC not supported"
			exit 1
		fi
	done

	while [[ -z $git_user_name ]]; do
		read -rp "Enter $MAG\0git user.name$NOC\0: " git_user_name
	done

	until [[ $git_user_email == *@*.* ]]; do
		read -rp "Enter $MAG\0git user.email$NOC\0: " git_user_email
	done

	until [[ ${AI,,}  == 'y' || ${AI,,} == 'n' ]]; do
		read -rp "Install $MAG\0local AI models$NOC\0 ? [y/n] " AI
	done

	log suc "Variables have been setup"
}

