update_pkgs() {
	log inf "Updating packages"
	$UPDATE_CMD || (log err "Packages update failed" && exit 1)
	log suc "Packages have been updated"
}

set_hostname() {
	log inf 'Setting up hostname'
	command -v sudo &>/dev/null || $INSTALL_CMD sudo
	sudo hostnamectl set-hostname "$hostname"
	log suc 'Hostname has been setup'
}

set_sudoer() {
	log inf "Adding $USER to wheel group"
	sudo usermod -aG wheel "$USER"
	read -rp "Setup passwordless sudo for $USER ? [y/n] " a
	if [[ ${a,,} == 'y' ]]; then
		tmp=$(sudo mktemp)
		trap 'rm -f "$tmp"' EXIT
		printf '%%wheel\tALL=(ALL)\tNOPASSWD: ALL\n' > "$tmp"
		sudo mv "$tmp" /etc/sudoers.d/10_wheel
		sudo chmod 0440 /etc/sudoers.d/10_wheel
		log suc "Passwordless sudo has been setup for $USER"
	fi

	log suc "$USER has been added to wheel group"
}

set_mounts() {
	log inf "Mounting NFS shares"
	$INSTALL_CMD nfs-utils || $INSTALL_CMD nfs-common
	local share_opts="nfs rw,defaults,soft,_netdev,noatime,nodiratime 0 0"
	local mnt_dirs=()
	while read -r l; do
		IFS=: read -r ip dataset mount <<< "$l"
		mnt_dirs+=("$mount")
		printf "%s:/%s/%s\t/mnt/%s\t%s\n" \
			"$ip" "$dataset" "$mount" "$mount" "$share_opts" \
			| sudo tee -a /etc/fstab &>/dev/null
	done < "$LISTS_DIR/mounts"

	for mount in "${mnt_dirs[@]}"; do
		sudo mkdir -p /mnt/"$mount"
	done

	sudo systemctl daemon-reload
	sudo mount -a
	log suc "NFS shares have been mounted"
}

set_ssh() {
	log inf "Setting up SSH"
	local ssh_dir="$HOME/.ssh"
	local ssh_config="$ssh_dir/config"
	local key="$ssh_dir/$hostname"
	mkdir -m 0700 "$ssh_dir"
	ssh-keygen -t ed25519 -f "$key" -N ""
	touch "$ssh_config" && chmod 600 "$ssh_config"
	while read -r l; do
		IFS=: read -r ip host user <<< "$l"
		ssh-copy-id -o StrictHostKeyChecking=no -i "$key.pub" "$user@$ip"
		printf 'Host %s\n
			\tHostName\t%s\n
			\tUser\t%s\n
			\tIdentityFile\t%s\n\n' \
			"$host" "$ip" "$user" "$key" \
			>> "$ssh_config"
	done < "$LISTS_DIR/local_devices"

	log suc "SSH has been setup"
}

set_git() {
	log inf "Setting up git"
	$INSTALL_CMD git
	git config --global user.name "$git_user_name"
	git config --global user.email "$git_user_email"

	while read -r l; do
		local host="$l"
		local key="$HOME/.ssh/git_${host%.*}"
		ssh-keygen -t ed25519 -C "$git_user_email" -f "$key" -N ""
		printf 'Host %s\n
			\tHostName\t%s\n
			\tUser\tgit\n
			\tIdentityFile\t%s\n\n' \
			"$host" "$host" "$key" \
			>> "$HOME/.ssh/config"
	done < "$LISTS_DIR/git_hosts"

	log suc "git has been setup"
}

set_repos() {
	log inf "Setting up repos"
	command -v git &>/dev/null || $INSTALL_CMD git
	while read -r l; do
		IFS=: read -r host name dest <<< "$l"
		dest_dir="$HOME/$dest"
		[[ -d $dest_dir ]] || mkdir -p "$dest_dir"
		[[ -d $dest_dir/${name##*/} ]] && continue
		git clone --recurse-submodules \
			"ssh://git@$host/$name.git $dest_dir"
	done < "$LISTS_DIR/repos"

	log suc "Repos have been setup"
}

get_pkgs() {
	log inf "Installing packages"
	while read -r l; do
		pkg=$l
		if [[ $pkg == fedora* ]]; then
			[[ $DISTRO == 'fedora' ]] || continue
			pkg=${pkg#fedora:}
		fi

		if [[ $pkg == copr* ]]; then
			[[ $DISTRO == 'fedora' ]] || continue
			copr_pkg=${pkg#copr:}
			pkg=${copr_pkg#*/}
			sudo dnf copr enable "$copr_pkg"
		fi

		if [[ $pkg == nfedora* ]]; then
			[[ $DISTRO != 'fedora' ]] || continue
			pkg=${pkg#nfedora:}
		fi

		$INSTALL_CMD "$pkg"
	done < "$LISTS_DIR/packages"
	log suc "Packages have been installed"
}

install_ai() {
	[[ $AI == 'y' ]] || return 0
	log inf "Installing AI local models"
	local ollama_config="$ENV_DIR/.config/ollama"
	$INSTALL_CMD ollama
	mkdir -p "$ollama_config/modelfiles"
	while read -r model; do
		ollama pull "$model"
		local modelfile="$ollama_config/modelfiles/Modelfile_$model"
		if [[ ! -f $modelfile ]]; then
			printf 'FROM %s\nPARAMETER num_ctx 16384' "$model" \
			> "$modelfile"
		fi

		ollama create "$model"-16k -f "$modelfile"
		ollama rm "$model"
	done < "$LISTS_DIR/ai_models"

	curl -fsSL https://opencode.ai/install | bash
	log suc "AI local models have been install"
}

install_font() {
	log inf "Installing Iosevka font"
	if fc-list : family | grep -qi "iosevka nerd font"; then
		log inf "Custom Iosevka font already installed."
		return 0
	fi

	local font_dir="$ENV_DIR/.local/share/fonts/IosevkaNerdFont"
	if [[ -d $font_dir ]]; then
		log inf "Custom Iosevka fonts already present"
		until [[ ${a,,} == 'y' || ${a,,} == 'n' ]]; do
			read -rp "	Reinstall ? [y/n] " a
			if [[ ${a,,} == 'n' ]]; then
				return 0
			fi
		done
	fi

	mkdir -p "$font_dir"

	tmp_dir="$(mktemp -d /font_build)"
	trap 'rm -rf "$tmp_dir"' EXIT
	local tmp_iosevka="$tmp_dir/iosevka"
	local tmp_patcher="$tmp_dir/patcher"
	local tmp_font="$tmp_dir/font"
	mkdir -p "$tmp_iosevka" "$tmp_patcher" "$tmp_font"

	git clone https://github.com/ryanoasis/nerd-fonts.git "$tmp_patcher"
	git clone --depth 1 \
		https://github.com/be5invis/Iosevka.git "$tmp_iosevka"

	$INSTALL_CMD nodejs npm ttfautohint fontforge python3 wget unzip
	cd "$tmp_iosevka" || exit 1
	cp -f "$ENV_DIR/.config/iosevka/private-build-plans.toml" ./
	npm install
	if ! npm run build -- ttf::Iosevka --jCmd=8; then
		log err "Iosevka font generation failed"
		exit 1
	fi

	while IFS= read -r -d '' ttf; do
		fontforge -script "$tmp_patcher/font-patcher" --complete \
			--careful --progressbars --outputdir "$tmp_font" \
			"$ttf" > /dev/null 2>&1 \
			|| log err "Iosevka $ttf patching failed"
	done < <(find "$tmp_iosevka/dist" -name "*.ttf" -print0)

	cp -f "$tmp_font/"*.ttf "$font_dir/"
	fc-cache -fv
	log suc "Iosevka font has been installed"
}

install_others() {
	log inf "Installing other softwares"
	src_dir="$HOME/src" && mkdir -p "$src_dir"

	# Not in dnf pkgs manager
	if [[ $DISTRO == 'fedora' ]]; then
		cargo install rmpc --locked
	fi

	# Oh My Posh
	curl -s https://ohmyposh.dev/install.sh | bash -s

	# Keyd
	git clone "https://github.com/rvaiya/keyd.git" "$src_dir"
	keyd_dir="$src_dir/keyd"
	cd "$keyd_dir" || (log err "Could not cd into $keyd_dir" && exit 1)
	make && sudo make install
	sudo ln -fs "$ENV_DIR/.config/keyd/default.conf" \
		/etc/keyd/
	sudo systemctl enable --now keyd

	log suc "Others softwares have been installed"
}

