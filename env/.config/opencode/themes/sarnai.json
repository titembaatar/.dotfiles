    "diffRemovedLineNumberBg": {
      "dark": "#3E322D",
      "light": "#3E322D"
    },
    "markdownText": {
      "dark": "text",
      "light": "text"
    },
    "markdownHeading": {
      "dark": "mus",
      "light": "mus"
    },
    "markdownLink": {
      "dark": "nuur",
      "light": "nuur"
    },
    "markdownLinkText": {
      "dark": "text",
      "light": "text"
    },
    "markdownCode": {
      "dark": "els",
      "light": "els"
    },
    "markdownBlockQuote": {
      "dark": "els",
      "light": "els"
    },
    "markdownEmph": {
      "dark": "chatsalgan",
      "light": "chatsalgan"
    },
    "markdownStrong": {
      "dark": "anis",
      "light": "anis"
    },
    "markdownHorizontalRule": {
      "dark": "subtle",
      "light": "subtle"
    },
    "markdownListItem": {
      "dark": "nuur",
      "light": "nuur"
    },
    "markdownListEnumeration": {
      "dark": "sarnai",
      "light": "sarnai"
    },
    "markdownImage": {
      "dark": "els",
      "light": "els"
    },
    "markdownImageText": {
      "dark": "text",
      "light": "text"
    },
    "markdownCodeBlock": {
      "dark": "#15231D",
      "light": "#15231D"
    },
    "syntaxComment": {
      "dark": "muted",
      "light": "muted"
    },
    "syntaxKeyword": {
      "dark": "nuur",
      "light": "nuur"
    },
    "syntaxFunction": {
      "dark": "sarnai",
      "light": "sarnai"
    },
    "syntaxVariable": {
      "dark": "text",
      "light": "text"
    },
    "syntaxString": {
      "dark": "els",
      "light": "els"
    },
    "syntaxNumber": {
      "dark": "els",
      "light": "els"
    },
    "syntaxType": {
      "dark": "mus",
      "light": "mus"
    },
    "syntaxOperator": {
      "dark": "subtle",
      "light": "subtle"
    },
    "syntaxPunctuation": {
      "dark": "subtle",
      "light": "subtle"
    }
  }
}
