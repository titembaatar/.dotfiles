# `man 5 tofi`.

# behaviour
hide-cursor = true
matching-algorithm = fuzzy

# fonts
font = "Iosevka Nerd Font"

# colors
background-color = #172620
text-color = #dfece7
text-cursor-color = #dfece7
text-cursor-background = #172620
prompt-color = #f0c3cb
default-result-color = #90bbaa
selection-color = #dfece7
selection-background = #2d493d
selection-match-color = #f0c3cb

# paddings
selection-background-padding = 0, 5000

# text
text-cursor = true
text-cursor-style = block
prompt-text = "; "

# window
output = "DP-1"
width = 100%
height = 100%
outline-width = 0
border-width = 0
padding-top = 50
padding-bottom = 50
padding-left = 50
padding-right = 50

