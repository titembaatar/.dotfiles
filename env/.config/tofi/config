# `man 5 tofi`.

# Fonts
font = "Iosevka Regular"
font-size = 12pt
hint-font = true

# Layout
result-spacing = 28
horizontal = true
min-input-width = 140

# Text
text-color = #dfece7
prompt-color = #f0c3cb
prompt-background-padding = 14
input-color = #dfece7
default-result-color = #4e7e6b
default-result-background-padding = 8
selection-color = #2b879e
selection-background-padding = 8
selection-match-color = #f0c3cb

# Cursor
text-cursor-style = block

# Prompt
prompt-text = " : "
prompt-padding = 12
placeholder-text = ""

# Window
width = 70%
height = 25
background-color = #172620
outline-width = 0
border-width = 0
corner-radius = 0
padding-top = 2
padding-bottom = 0
padding-left = 16
clip-to-padding = false
scale = true

# Window position
output = "DP-1"
anchor = top-left
exclusive-zone = -1
margin-top = 0
margin-bottom = 0
margin-left = 0
margin-right = 0

# Behaviour
hide-cursor = false
text-cursor = true
history = true
matching-algorithm = fuzzy
require-match = true
auto-accept-single = false
hide-input = false
hidden-character = "*"
physical-keybindings = true
print-index = false
drun-launch = false
terminal= kitty
late-keyboard-init = false
multi-instance = false
ascii-input = false
