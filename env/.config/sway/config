# `man 5 sway`

include /etc/sway/config.d/*

###
##  VARIABLES
#

# Mod4 = logo key, Mod1 = Alt
set $mod Mod4

# VIIIIIIIIM
set $left  h
set $down  j
set $up    k
set $right l

# Monitor
set $d1 "DP-1"
set $d2 "DP-2"

# Apps
set $term    alacritty
set $browser zen-browser
set $music   gtk-launch com.plexamp.Plexamp
set $chat    gtk-launch dev.vencord.Vesktop
set $menu    tofi-drun | xargs swaymsg exec --

# Scripts
set $tofi-ssh     $HOME/.config/tofi/ssh.sh
set $tofi-emoji   $HOME/.config/tofi/emoji.sh

# Exit mode
set $exit "[l]ogout [s]leep [r]eboot [p]oweroff"

# Colorscheme sarnai
set $base			  #172620
set $surface	  #21362d
set $overlay	  #2d493d
set $muted		  #4e7e6b
set $subtle		  #90bbaa
set $text			  #dfece7
set $sarnai		  #f0c3cb
set $anis       #ff6b6b
set $chatsalgan #e5951a
set $els			  #cca24d
set $uvs			  #80b946
set $nuur       #2b879e
set $mus        #9deaea
set $yargui			#d5b3e5

###
##  EXEC
#

# waybar:
exec_always "killall waybar || true; waybar"

###
##  OPTS
#

# Displays
output $d1 {
  bg /home/titem/Pictures/gowall/OI001188.jpg fill
  resolution 2560x1440 position 1440,560
}
output $d2 {
  bg /home/titem/Pictures/gowall/OI001236.jpg fill
  resolution 1440x2560 transform 270 position 0,0
}

# Workspace
workspace 1 output $d1
workspace 2 output $d1
workspace 3 output $d1
workspace 4 output $d1
workspace 5 output $d1
workspace 6 output $d2
workspace 7 output $d2
workspace 8 output $d2
workspace 9 output $d2
workspace 0 output $d2

# Window
default_border 					pixel 2
default_floating_border normal
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="MEGAsync" title="MEGAsync"] floating enable

# target                title    bg      text   indicator	border
client.focused          $base    $sarnai $base  $sarnai  $sarnai
client.focused_inactive $muted   $base   $muted $muted   $muted
client.unfocused        $muted   $base   $muted $sarnai  $muted
client.urgent           $anis    $base   $anis  $surface $anis
client.placeholder      $surface $base   $text  $surface $surface
client.background       $base

# Cursor
seat seat0 xcursor_theme phinger-cursors-light 40

# Keyboard
input "type:keyboard" {
  xkb_layout us,us(intl)
  xkb_options grp:rctrl_toggle
}

###
##  KEYMAPS
#

# Modes

# Exit mode
mode $exit {
  bindsym --to-code {
    l exec swaymsg exit
    s exec systemctl suspend,   mode "default"
    p exec systemctl poweroff
    r exec systemctl reboot

    Return mode "default"
    Escape mode "default"
    $mod+x mode "default"
  }
}
bindsym --to-code $mod+x mode $exit

# Resize mode
mode "resize" {
	bindsym $left  resize shrink width  5
	bindsym $down  resize grow   height 5
	bindsym $up    resize shrink height 5
	bindsym $right resize grow   width  5

	bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"


# User keybinds

# tofi
bindsym $mod+d      exec $menu
bindsym $mod+q      exec $tofi-ssh
bindsym $mod+period exec $tofi-emoji

# Apps
bindsym $mod+Return       exec $term
bindsym $mod+bracketleft  exec $music
bindsym $mod+bracketright exec $chat
bindsym $mod+backslash    exec $browser

# Screenshot
bindsym $mod+p       exec grimshot savecopy active
bindsym $mod+Shift+p exec grimshot savecopy window
bindsym $mod+Alt+p   exec grimshot savecopy area

# Volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# Brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

###
##  SWAY KEYMAPS
#

# Reload the configuration file
bindsym $mod+Shift+c reload

# Move focus
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# Move focused window
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# Switch workspace
bindsym $mod+Ctrl+$left  workspace prev
bindsym $mod+Ctrl+$right workspace next
bindsym $mod+1           workspace number 1
bindsym $mod+2           workspace number 2
bindsym $mod+3           workspace number 3
bindsym $mod+4           workspace number 4
bindsym $mod+5           workspace number 5
bindsym $mod+6           workspace number 6
bindsym $mod+7           workspace number 7
bindsym $mod+8           workspace number 8
bindsym $mod+9           workspace number 9
bindsym $mod+0           workspace number 10

# Move focus to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Kill focused window
bindsym $mod+Shift+q kill

# Exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Slipts
bindsym $mod+b splith
bindsym $mod+v splitv

# Layouts
bindsym $mod+f fullscreen
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Toggle the current focus between tiling and floating mode
bindsym $mod+space floating toggle

