# `man 5 sway`

include /etc/sway/config.d/*
include ./sarnai
exec_always "killall waybar || true; waybar"

set $mod Mod4
set $alt Mod1
set $left h
set $down j
set $up k
set $right l

set $term ghostty
set $browser firefox
set $music $term --title=rmpc -e $HOME/.cargo/bin/rmpc

set $fzf-drun        $HOME/.dotfiles/env/.local/bin/fzf-drun
set $sessioniser     $HOME/.local/bin/tmux-sessioniser
set $ssh-sessioniser $HOME/.local/bin/ssh-sessioniser
set $fzf-cmus        $HOME/.local/bin/fzf-cmus
set $fzf-emoji       $HOME/.local/bin/fzf-emoji
set $pob             $HOME/.local/bin/pob
set $pob2            $HOME/.local/bin/pob2

set $d1 "DP-1"
set $d2 "DP-2"

smart_borders no_gaps
smart_gaps on
default_border pixel 2
default_floating_border normal
gaps inner 4
seat seat0 xcursor_theme phinger-cursors-light 40
input "type:keyboard" {
  xkb_layout us
  xkb_options compose:ralt
}

output $d1 {
	bg /home/titem/Pictures/wallpapers/saran_h_1.jpg fill
	resolution 2560x1440 position 1440,560
}
output $d2 {
	bg /home/titem/Pictures/wallpapers/saran_v_2.jpg fill
	resolution 1440x2560 transform 270 position 0,0
}

workspace 1 output $d1
workspace 2 output $d1
workspace 3 output $d1
workspace 4 output $d1
workspace 5 output $d1
workspace 6 output $d2 layout splitv
workspace 7 output $d2 layout splitv
workspace 8 output $d2 layout splitv
workspace 9 output $d2 layout splitv
workspace 0 output $d2 layout splitv

for_window [window_role="pop-up|bubble|dialog"] floating enable
for_window [window_type="dialog"]               floating enable
for_window [title="sessioniser"]                floating enable, fullscreen enable
for_window [class="MEGAsync"]                   floating enable

assign [title="tmux"]     workspace 1
assign [app_id="firefox"] workspace 2
assign [class="steam"]    workspace 3
assign [class="resolve"]  workspace 4
assign [class="MEGAsync"] workspace 5
assign [app_id="zen"]     workspace 6
assign [title="rmpc"]     workspace 6

# keybinds

mode "resize" {
	bindsym {
		$left  resize shrink width  5ppt
		$up    resize grow   height 5ppt
		$down  resize shrink height 5ppt
		$right resize grow   width  5ppt
		Escape mode   "default"
	}
}

set $exit "[l]ogout [s]leep [r]eboot [p]oweroff"
mode $exit {
  bindsym --to-code {
    l exec swaymsg exit
    s exec systemctl suspend,   mode "default"
    p exec systemctl poweroff
    r exec systemctl reboot

    Return mode "default"
    Escape mode "default"
    $mod+x mode "default"
  }
}

set $search "[s]ession [S]SH [m]usic [.]👀"
mode $search {
	bindsym --to-code {
		s       exec $term --title=sessioniser -e $sessioniser
		Shift+s exec $term --title=sessioniser -e $ssh-sessioniser
		m       exec $term --title=sessioniser -e $fzf-cmus
		period  exec $term --title=sessioniser -e $fzf-emoji

		Return  mode "default"
		Escape  mode "default"
		$mod+s  mode "default"
	}
	bindsym --release {
		s       mode "default"
		Shift+s mode "default"
		m       mode "default"
		period  mode "default"
	}
}

bindsym {
	# PERSONAL KEYMAPS
	$mod+r           mode "resize"
	--to-code $mod+x mode $exit
	--to-code $mod+s mode $search

	$mod+Return exec $term --title=tmux -e tmux new -A -s home
	$mod+b      exec $browser
	$mod+d      exec $term --title=sessioniser -e $fzf-drun
	$mod+m      exec $music
	$mod+e      exec /opt/resolve/bin/resolve

	$mod+backslash  exec zen-browser
	$mod+bar        exec steam
	$mod+braceleft  exec $pob
	$mod+braceright exec $pob2

	$mod+p       exec grimshot savecopy --notify --wait 1 active
	$mod+Shift+p exec grimshot savecopy --notify --wait 1 window
	$mod+Alt+p   exec grimshot savecopy --notify --wait 1 area

	--locked XF86AudioMute        exec pactl set-sink-mute   \@DEFAULT_SINK@ toggle
	--locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
	--locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
	--locked XF86AudioMicMute     exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

	# SWAY KEYMAPS
	$mod+Shift+c reload
	$mod+w       kill
	$mod+f       fullscreen
	$mod+space   floating toggle
	$mod+c       splith
	$mod+v       splitv

	$mod+$left        focus left
	$mod+$down        focus down
	$mod+$up          focus up
	$mod+$right       focus right
	$mod+Shift+$left  move  left
	$mod+Shift+$down  move  down
	$mod+Shift+$up    move  up
	$mod+Shift+$right move  right

	$mod+1 workspace number 1
	$mod+2 workspace number 2
	$mod+3 workspace number 3
	$mod+4 workspace number 4
	$mod+5 workspace number 5
	$mod+6 workspace number 6
	$mod+7 workspace number 7
	$mod+8 workspace number 8
	$mod+9 workspace number 9
	$mod+0 workspace number 10

	$mod+Shift+1 move container to workspace number 1
	$mod+Shift+2 move container to workspace number 2
	$mod+Shift+3 move container to workspace number 3
	$mod+Shift+4 move container to workspace number 4
	$mod+Shift+5 move container to workspace number 5
	$mod+Shift+6 move container to workspace number 6
	$mod+Shift+7 move container to workspace number 7
	$mod+Shift+8 move container to workspace number 8
	$mod+Shift+9 move container to workspace number 9
	$mod+Shift+0 move container to workspace number 10
}
