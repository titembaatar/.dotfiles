# `man 5 sway`

include /etc/sway/config.d/*

###
##  COLORSCHEME SARNAI
#

set $base       #172620
set $surface    #21362d
set $overlay    #2d493d
set $muted      #4e7e6b
set $subtle     #90bbaa
set $text       #dfece7
set $sarnai     #f0c3cb
set $anis       #ff6b6b
set $chatsalgan #e5951a
set $els        #cca24d
set $uvs        #80b946
set $nuur       #2b879e
set $mus        #9deaea
set $yargui     #d5b3e5

###
##  VARIABLES
#

# Mod4 = logo key, Mod1 = Alt
set $mod Mod4
set $alt Mod1

# VIIIIIIIIM
set $left  h
set $down  j
set $up    k
set $right l

# monitor
set $d1 "DP-1"
set $d2 "DP-2"

# scripts
set $fzf-drun        $HOME/.dotfiles/env/.local/bin/fzf-drun
set $sessioniser     $HOME/.local/bin/tmux-sessioniser
set $ssh-sessioniser $HOME/.local/bin/ssh-sessioniser
set $fzf-cmus        $HOME/.local/bin/fzf-cmus
set $fzf-emoji       $HOME/.local/bin/fzf-emoji
set $pob             $HOME/.local/bin/pob
set $pob2            $HOME/.local/bin/pob2

# apps
set $term    ghostty
set $browser zen-browser
set $music   $term --title=rmpc -e $HOME/.cargo/bin/rmpc

# exit mode
set $exit "[l]ogout [s]leep [r]eboot [p]oweroff"

###
##  EXEC
#

# waybar:
exec_always "killall waybar || true; waybar"

###
##  OPTS
#

# displays
output $d1 {
  bg /home/titem/Pictures/gowall/OI001188.jpg fill
  resolution 2560x1440 position 1440,560
}
output $d2 {
  bg /home/titem/Pictures/gowall/OI001236.jpg fill
  resolution 1440x2560 transform 270 position 0,0
}

# workspace
workspace 1 output $d1
workspace 2 output $d1
workspace 3 output $d1
workspace 4 output $d1
workspace 5 output $d1
workspace 6 output $d2 layout splitv
workspace 7 output $d2 layout splitv
workspace 8 output $d2 layout splitv
workspace 9 output $d2 layout splitv
workspace 0 output $d2 layout splitv

# window
default_border pixel 2
default_floating_border normal
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="MEGAsync" title="MEGAsync"] floating enable
for_window [title="sessioniser"] floating enable
for_window [title="sessioniser"] fullscreen enable

# target                title    bg      text   indicator	border
client.focused          $base    $sarnai $base  $sarnai  $sarnai
client.focused_inactive $muted   $base   $muted $muted   $muted
client.unfocused        $muted   $base   $muted $sarnai  $muted
client.urgent           $anis    $base   $anis  $surface $anis
client.placeholder      $surface $base   $text  $surface $surface
client.background       $base

# cursor
seat seat0 xcursor_theme phinger-cursors-light 40

# keyboard
input "type:keyboard" {
  xkb_layout us
  xkb_options compose:ralt
}

###
##  KEYMAPS
#

# exit mode
mode $exit {
  bindsym --to-code {
    l exec swaymsg exit
    s exec systemctl suspend,   mode "default"
    p exec systemctl poweroff
    r exec systemctl reboot

    Return mode "default"
    Escape mode "default"
    $mod+x mode "default"
  }
}
bindsym --to-code $mod+x mode $exit

# resize mode
mode "resize" {
	bindsym $left  resize shrink width  5ppt
	bindsym $up    resize grow   height 5ppt
	bindsym $down  resize shrink height 5ppt
	bindsym $right resize grow   width  5ppt

	bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"


# launcher
bindsym $mod+d      exec $term --title=sessioniser -e $fzf-drun
bindsym $mod+m      exec $term --title=sessioniser -e $fzf-cmus
bindsym $mod+period exec $term --title=sessioniser -e $fzf-emoji
bindsym $mod+u      exec $term --title=sessioniser -e $sessioniser
bindsym $mod+i      exec $term --title=sessioniser -e $ssh-sessioniser

# apps
bindsym $mod+Return       exec $term --title=tmux -e tmux new -A -s home
bindsym $mod+bracketleft  exec $music
bindsym $mod+bracketright exec $chat
bindsym $mod+backslash    exec $browser

# gaming
bindsym $mod+bar          exec steam
bindsym $mod+braceleft    exec $pob
bindsym $mod+braceright   exec $pob2

# screenshot
bindsym $mod+p       exec grimshot savecopy active
bindsym $mod+Shift+p exec grimshot savecopy window
bindsym $mod+Alt+p   exec grimshot savecopy area

# volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

###
##  SWAY KEYMAPS
#

# reload the configuration file
bindsym $mod+Shift+c reload

# move focus
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# move focused window
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# switch workspace
bindsym $mod+1           workspace number 1
bindsym $mod+2           workspace number 2
bindsym $mod+3           workspace number 3
bindsym $mod+4           workspace number 4
bindsym $mod+5           workspace number 5
bindsym $mod+6           workspace number 6
bindsym $mod+7           workspace number 7
bindsym $mod+8           workspace number 8
bindsym $mod+9           workspace number 9
bindsym $mod+0           workspace number 10

# move focus to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# kill focused window
bindsym $mod+w kill

# exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# slipts
bindsym $mod+b splith
bindsym $mod+v splitv

# layouts
bindsym $mod+f fullscreen
bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+e layout toggle split

# toggle the current focus between tiling and floating mode
bindsym $mod+space floating toggle

