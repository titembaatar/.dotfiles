{
  "sway/workspaces": {
    "format": "{icon}",
    "disable-scroll": true,
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "󰿎",
      "5": ""
    },
    "persistent-workspaces": {
      "1": ["eDP-1"],
      "2": ["eDP-1"],
      "3": ["eDP-1"],
      "4": ["eDP-1"],
      "5": ["eDP-1"]
    }
  },

  "disk": {
    "format": "󰋊 {percentage_used}%",
    "path": "/",
    "states": {
      "warning": 70,
      "critical": 85
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
    "scroll-step": 1,
    "states": {
      "low": 25,
      "normal": 80,
      "warning": 100,
      "critical": 999
    },
    "on-click-right": "pavucontrol"
  },

  "battery": {
    "interval": 60,
    "states": {
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""]
}
}
