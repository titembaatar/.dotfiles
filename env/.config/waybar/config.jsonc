[
  {
    "output": "DP-1",
    "include": [ "~/.dotfiles/env/.config/waybar/config.default.jsonc" ],
    "modules-right": [
      "custom/homelab",
      "custom/tailscale",
      "bluetooth",
      "custom/delimitor",
      "disk",
      "cpu",
      "memory",
      "pulseaudio",
      "clock"
    ]
  },
  {
    "output": "DP-2",
    "include": [ "~/.dotfiles/env/.config/waybar/config.default.jsonc" ],
    "modules-right": [ "pulseaudio", "clock" ]
  }
]
