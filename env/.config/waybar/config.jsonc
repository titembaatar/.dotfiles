[{
	"name": "main",
  "layer": "top",
	"height": 24,
	"output": "DP-1",

  "modules-left": [
		"custom/homelab",
		"sway/workspaces",
		"sway/mode"
	],

  "modules-center": [ "sway/window" ],

  "modules-right": [
    "network",
		"disk",
		"memory",
    "pulseaudio",
		"clock"
	],

  "custom/homelab": {
    "format": "[<span rise='1pt'> {text}</span>]",
    "exec": "$HOME/.config/waybar/scripts/homelab.sh 2> /dev/null",
    "interval": 30,
    "return-type": "json"
  },

	"sway/workspaces": {
    "format": "[{name}]",
		"disable-scroll": true,
		"disable-click": true
	},

	"sway/mode": {
		"format": "; {}",
    "max-length": 75
	},

	"sway/window": {
		"format": "[{title}]",
		"max-length": 50
	},

	"network": {
		"tooltip": false,
		"format": "[<span rise='1pt'>󰈀 up</span>]",
		"format-disabled": "[<span rise='1pt'>󰈀 nil</span>]",
		"format-disconnected": "[<span rise='1pt'>󰈀 down</span>]"
	},

	"disk": {
		"format": "[<span rise='1pt'>󰋊</span> {percentage_free}%]",
		"path": "/mnt/yesugei/",
    "states": {
      "warning": 50,
      "critical": 80
    }
	},

	"memory": {
		"format": "[<span rise='1pt'></span> {used}G]",
		"tooltip-format": "MEM: {avail}G available, {used}/{total}G\nSWAP: {swapAvail}G available, {swapUsed}/{swapTotal}G",
    "states": {
      "warning": 80,
      "critical": 90
    }
	},

	"pulseaudio": {
		"format": "[<span rise='1pt'>{icon}</span> {volume}]",
    "format-muted": "[<span rise='1pt'></span> 00]",
    "format-icons": {
      "default": ["", "", ""]
    },
		"scroll-step": 1,
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol",
    "states": {
      "high": 100,
      "mid": 40,
      "low": 10
    }
	},

  "clock": {
    "format": "[<span rise='1pt'>󰨳</span> {:%m%d.%H%M}]",
		"interval": 60,
    "tooltip-format": "<tt>{calendar}</tt>"
  }
},
{
	"name": "second",
  "layer": "top",
	"height": 24,
	"output": "DP-2",

  "modules-left": [
		"custom/spacer",
		"sway/workspaces",
		"custom/spacer",
		"sway/mode"
	],
  "modules-center": ["sway/window"],
  "modules-right": [
    "pulseaudio",
		"clock"
	],

	"sway/workspaces": {
		"format": "[{name}]",
		"disable-scroll": true,
		"disable-click": true
	},

	"sway/mode": {
		"format": "; {}",
    "max-length": 75
	},

	"sway/window": {
		"max-length": 50
	},

	"pulseaudio": {
		"format": "[<span rise='1pt'>{icon}</span> {volume}]",
    "format-muted": "[<span rise='1pt'></span> 00]",
    "format-icons": {
      "default": ["", "", ""]
    },
		"scroll-step": 1,
		"on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol",
    "states": {
      "high": 100,
      "mid": 40,
      "low": 10
    }
	},

  "clock": {
    "format": "[<span rise='1pt'>󰨳</span> {:%m%d.%H%M}]",
		"interval": 60,
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}]
