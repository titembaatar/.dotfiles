[
  {
    "output": "DP-1",
    "include": [
      "~/.dotfiles/env/.config/waybar/config.default.jsonc",
      "~/.dotfiles/env/.config/waybar/modules.default.jsonc",
      "~/.dotfiles/env/.config/waybar/modules.desktop.jsonc"
    ],
    "modules-right": [
      "custom/homelab",
      "custom/tailscale",
      "bluetooth",
      "custom/delimitor",
      "disk",
      "cpu",
      "memory",
      "pulseaudio",
      "clock"
    ]
  },
  {
    "output": "DP-2",
    "include": [
      "~/.dotfiles/env/.config/waybar/config.default.jsonc",
      "~/.dotfiles/env/.config/waybar/modules.default.jsonc",
      "~/.dotfiles/env/.config/waybar/modules.desktop.jsonc"
    ],
    "modules-right": [ "pulseaudio", "clock" ]
  },
  {
    "output": "eDP-1",
    "include": [
      "~/.dotfiles/env/.config/waybar/config.default.jsonc",
      "~/.dotfiles/env/.config/waybar/modules.default.jsonc",
      "~/.dotfiles/env/.config/waybar/modules.laptop.jsonc"
    ],
    "modules-right": [
      "custom/homelab",
      "custom/delimitor",
      "battery",
      "disk",
      "cpu",
      "memory",
      "pulseaudio",
      "clock"
    ]
  }
]
