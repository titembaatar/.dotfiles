{
  "custom/delimitor": {
    "format": "///"
  },

  "sway/workspaces": {
    "format": "{icon}",
    "disable-scroll": true,
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "󰿎",
      "5": ""
    },
    "persistent-workspaces": {
      "1": ["DP-1"],
      "2": ["DP-1"],
      "3": ["DP-1"],
      "4": ["DP-1"],
      "5": ["DP-1"]
    }
  },

  "sway/mode": {
    "format": "; {}",
    "max-length": 75
  },

  "sway/window": {
    "max-length": 75
  },

  "custom/homelab": {
    "format": "",
    "exec": "$HOME/.config/waybar/scripts/homelab.sh",
    "interval": 30,
    "return-type": "json"
  },

  "custom/tailscale": {
    "format": "{icon}",
    "format-icons": {
      "on": "󰞀",
      "off": "󰦞"
    },
    "exec": "$HOME/.config/waybar/scripts/tailscale.sh --status",
    "on-click": "$HOME/.config/waybar/scripts/tailscale.sh --toggle",
    "interval": 30,
    "return-type": "json"
  },

  "bluetooth": {
    "on-click": "$HOME/.config/waybar/scripts/bluetooth.sh --connect",
    "on-click-middle": "$HOME/.config/waybar/scripts/bluetooth.sh --toggle",
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 10,
    "tooltip-format": "ps -eo cmd,%cpu --sort=-%cpu | head",
    "states": {
      "warning": 70,
      "critical": 85
    }
  },

  "memory": {
    "format": " {percentage}%",
    "tooltip-format": "MEM: {avail}G available, {used}/{total}G\nSWAP: {swapAvail}G available, {swapUsed}/{swapTotal}G",
    "states": {
      "warning": 70,
      "critical": 85
    }
  },

  "clock": {
    "format": "󰨳 {:%m%d.%H%M}",
    "interval": 60,
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
