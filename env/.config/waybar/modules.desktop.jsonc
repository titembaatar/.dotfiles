{
  "sway/workspaces": {
    "format": "{icon}",
    "disable-scroll": true,
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "󰿎",
      "5": ""
    },
    "persistent-workspaces": {
      "1": ["DP-1"],
      "2": ["DP-1"],
      "3": ["DP-1"],
      "4": ["DP-1"],
      "5": ["DP-1"]
    }
  },

  "disk": {
    "format": "󰋊 {percentage_used}%",
    "path": "/mnt/yesugei/",
    "states": {
      "warning": 70,
      "critical": 85
    }
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "alsa_output.usb-Generic_USB_Audio-00.HiFi__Speaker__sink": "󰋋",
      "alsa_output.usb-Generic_USB_Audio-00.HiFi__SPDIF__sink": "󰓃",
      "bluez_output.18:9C:2C:B2:FF:67": "󰂯"
    },
    "scroll-step": 1,
    "states": {
      "low": 25,
      "normal": 80,
      "warning": 100,
      "critical": 999
    },
    "on-click": "$HOME/.config/waybar/scripts/pulseaudio.sh",
    "on-click-right": "pavucontrol"
  }
}
