# path
addToPath() {
  if [[ ! -z "$2" ]] || [[ "$PATH" != *"$1"* ]]; then
    export PATH=$1:$PATH
  fi
}

addToPath "$HOME/.local/bin"
addToPath "/usr/local/go/bin"

# aliases
alias rzsh="source $HOME/.zshrc"
alias vim="nvim"
alias lzg="lazygit"
alias lzd="lazydocker"
alias mdu="du -h --max-depth=1 ./"
alias trash="rm -rf /mnt/yesugei/.Trash-1000/*"

alias dot="cd $HOME/.dotfiles"
alias souen="cd /mnt/yesugei/souen/ && yazi"

alias poetrade="'$HOME/Downloads/Awakened-PoE-Trade-'*.AppImage --no-overlay --listen=localhost:5555 > /dev/null 2>&1 & disown"

# defaults
export EDITOR="nvim"
export BROWSER="zen-browser"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_SCREENSHOTS_DIR="$HOME/Pictures/Screenshots/"

# ohmyposh
eval "$(oh-my-posh init zsh --config $HOME/.config/ohmyposh/titem.toml)"

