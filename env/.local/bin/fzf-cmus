#!/usr/bin/env bash

export PATH="$HOME/.cargo/bin":$PATH
source "$HOME/.config/fzf/config"

music_path="/mnt/data/media/music"

albums=$(find "$music_path" -mindepth 2 -maxdepth 2 -type d)

selected=$(fzf --prompt "music: " -d '/' --with-nth 6.. <<< "$albums")
[[ -z "$selected" ]] && exit 0

# RMPC
relative_selected=${selected#*/music/}

rmpc clear
rmpc add "$relative_selected"
rmpc play

# CMUS
# cmus-remote -c -q "$selected"
# sleep 0.1
# cmus-remote -n -p

