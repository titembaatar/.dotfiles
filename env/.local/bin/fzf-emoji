#!/usr/bin/env bash

source $HOME/.config/fzf/config

emoji_dir="$HOME/.dotfiles/env/personal/emoji"
emoji_file="$emoji_dir/emoji.txt"
nerd_icons_file="$emoji_dir/nerd_icons.txt"
combined_file="$emoji_dir/combined_icons.txt"

download_emoji_list() {
    curl -s "https://unicode.org/Public/emoji/latest/emoji-test.txt" | \
        grep -v '^#' | \
        grep "fully-qualified" | \
        sed -E 's/^.+# ([^ ]+) E[0-9.]+ (.+)/\1 \2/' | \
        grep -v "skin tone" > "$emoji_file"
    }

download_nerd_icons() {
    local tmp_dir
    tmp_dir=$(mktemp -d)

    api_url="https://api.github.com/repos/ryanoasis/nerd-fonts/contents/bin/scripts/lib"
    mapfile -t scripts < <(curl -s "$api_url" | jq -r '.[].name | select(test("\\.sh$"))')

    for script in "${scripts[@]}"; do
        [[ $script == "i_all" ]] && continue

        local url="https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/bin/scripts/lib/$script"

        if ! curl -sLf "$url" -o "$tmp_dir/$script" 2>/dev/null; then
            echo "[WARN] could not download $script"
        fi
    done

    local tmp_icons="$tmp_dir/all_icons.txt"

    for script_file in "$tmp_dir"/*.sh; do
        [[ -f "$script_file" ]] || continue

        while IFS= read -r line; do
            [[ $line =~ ^i=\'(.*)\'\ i_([^=]+)=\$i$ ]] || continue
            printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]//_/ }"
        done < "$script_file"

    done >> "$tmp_icons"

    sort "$tmp_icons" | uniq > "$nerd_icons_file"
    rm -rf "$tmp_dir"
}

create_combined_list() {
    {
        sed 's/^/glyph /' "$nerd_icons_file"
        sed 's/^/emoji /' "$emoji_file"
    } > "$combined_file"
}

main() {
    mkdir -p "$emoji_dir"

    [[ ! -f "$emoji_file" ]] && download_emoji_list
    [[ ! -f "$nerd_icons_file" ]] && download_nerd_icons

    create_combined_list

    selected=$(fzf --prompt "icon: " < "$combined_file")
    [[ -z "$selected" ]] && exit 0

    read -r _ icon <<< "$selected"
    [[ -n "$icon" ]] && wl-copy "$icon"
}

main

