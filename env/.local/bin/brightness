#!/usr/bin/env bash

steps=25

case $1 in
    up)   val=$(( $(sudo ddcutil getvcp 10 | grep -o 'current value *= *[0-9]*' | awk '{print $4}' | head -1) + steps )) ;;
    down) val=$(( $(sudo ddcutil getvcp 10 | grep -o 'current value *= *[0-9]*' | awk '{print $4}' | head -1) - steps )) ;;
esac

[[ $val -gt 100 ]] && val=100
[[ $val -lt 0 ]] && val=0

sudo ddcutil setvcp 10 --display 1 $val
sudo ddcutil setvcp 10 --display 2 $val
