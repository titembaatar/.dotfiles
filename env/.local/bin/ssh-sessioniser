#!/usr/bin/env bash

source "$HOME/.config/fzf/config"

switch_to() {
    if swaymsg -t get_tree --raw | jq -e '.. | .name? // empty | select(. == "tmux")'; then
        tmux switch-client -t "$1"
    else
        swaymsg exec "alacritty -T tmux -e tmux attach-session -t $1"
    fi
}

mapfile -t hosts < <(awk '/^Host / {print $2}' "$HOME/.ssh/config")

selected_host=$(printf '%s\n' "${hosts[@]}" | fzf --prompt "ssh: ")

[[ -z $selected_host ]] && exit 0

selected_name=${selected_host//./_}

if ! tmux has-session -t "$selected_name"; then
    tmux new-session -ds "$selected_name"
    tmux send-keys -t "$selected_name" "ssh $selected_host" C-m
fi

switch_to "$selected_name"
