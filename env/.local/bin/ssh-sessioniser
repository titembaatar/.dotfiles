#!/usr/bin/env bash
set -e
source $HOME/.config/fzf/config

switch_to() {
  if swaymsg -t get_tree --raw | jq -e '.. | .name? // empty | select(. == "tmux")' >/dev/null; then
    tmux switch-client -t "$1"
  else
    swaymsg exec "alacritty -T tmux -e tmux attach-session -t $1"
  fi
}

has_session() {
  tmux list-sessions 2>/dev/null | grep -q "^$1:"
}

selected_host=$(grep -i '^Host' ~/.ssh/config | awk '{print $2}' | \
  fzf --prompt "ssh: ")

if [[ -z $selected_host ]]; then
  exit 0
fi

selected_name=$(echo "$selected_host" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -ds "$selected_name"
  tmux send-keys -t "$selected_name" "ssh $selected_host" C-m
fi

if ! has_session "$selected_name"; then
  tmux new-session -ds "$selected_name"
  tmux send-keys -t "$selected_name" "ssh $selected_host" C-m
fi

switch_to "$selected_name"
