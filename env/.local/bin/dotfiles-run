#!/usr/bin/env bash
set -e
source $HOME/.dotfiles/pkg

dotfiles_dir="$HOME/.dotfiles"
runs_dir="$dotfiles_dir/runs"
grep=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --help|-h)
      echo "Usage: $0 [OPTIONS] [GREP_PATTERN]"
      echo
      echo "Options:"
      echo "  --help, -h"
      exit 0
      ;;
    *)
      grep="$1"
      shift
      ;;
  esac
done

if [[ ! -d "$dotfiles_dir" ]]; then
  log_error "$dotfiles_dir not found"
  exit 1
fi

if [[ ! -d "$runs_dir" ]]; then
  log_error "$runs_dir not found"
  exit 1
fi

scripts=$(find "$runs_dir" -mindepth 1 -maxdepth 1 -executable | sort)

if [[ -z "$scripts" ]]; then
  log_warn "no executable scripts found in $runs_dir"
  exit 1
fi

filtered_scripts=()
for script in $scripts; do
  script_name=$(basename "$script")

  if [[ -n "$grep" ]] && ! echo "$script_name" | grep -q "$grep"; then
    continue
  fi

  filtered_scripts+=("$script")
done

if [[ ${#filtered_scripts[@]} -eq 0 ]]; then
  log_warn "no scripts match the criteria"
  exit 1
fi

for script in "${filtered_scripts[@]}"; do
  script_name=$(basename "$script")

  if ! "$script"; then
    log_error "$script_name failed"
    exit 1
  fi

  log_success "completed $script_name"
done

cd "$dotfiles_dir"
stow env

log_success "all scripts completed successfully!"
