#!/usr/bin/env bash
set -e
source $HOME/.dotfiles/pkg

dotfiles_dir="$HOME/.dotfiles"
runs_dir="$dotfiles_dir/runs"

if [[ ! -d "$dotfiles_dir" ]]; then
  log_error "$dotfiles_dir not found"
  exit 1
fi

if [[ ! -d "$runs_dir" ]]; then
  log_error "$runs_dir not found"
  exit 1
fi

grep=""

if [ -n "$1" ]; then
  grep="$1"
fi

scripts=$(find "$runs_dir" -mindepth 1 -maxdepth 1 -executable | sort)

if [[ -z "$scripts" ]]; then
  log_warn "no executable scripts found in $runs_dir"
  exit 1
fi

for script in $scripts; do
  script_name=$(basename "$script")

  if echo "$script_name" | grep -vq "$grep"; then
    log_info "grep '$grep' filtered out $script_name"
    continue
  fi

  if ! "$script"; then
    log_error "$script_name failed"
    exit 1
  fi

  log_success "completed $script_name"
done

cd "$dotfiles_dir"
stow env

log_success "all scripts completed successfully!"

