#!/usr/bin/env bash
set -e

dotfiles_dir="$HOME/.dotfiles"
runs_dir="$dotfiles_dir/runs"
env_dir="$dotfiles_dir/env"

if [[ ! -d "$dotfiles_dir" ]]; then
  echo "[ERROR] $dotfiles_dir not found"
  exit 1
fi

if [[ ! -d "$runs_dir" ]]; then
  echo "[ERROR] $runs_dir not found"
  exit 1
fi

grep=""

if [ -n "$1" ]; then
  grep="$1"
fi

scripts=$(find "$runs_dir" -mindepth 1 -maxdepth 1 -executable)

if [[ -z "$scripts" ]]; then
  echo "[WARN ] no executable scripts found in $runs_dir"
  exit 1
fi

for script in $scripts; do
  script_name=$(basename "$script")

  if echo "$script_name" | grep -vq "$grep"; then
    echo "grep '$grep' filtered out $script_name"
    continue
  fi

  if ! "$script"; then
    echo "[ERROR] $script_name failed"
    exit 1
  fi

  echo "[INFO ] completed $script_name"
done

stow "$env_dir"

echo "[INFO ] all scripts completed successfully!"

