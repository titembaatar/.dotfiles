#!/usr/bin/env bash
set -euo pipefail
source "$HOME/.config/fzf/config"
shopt -s nullglob

DIRS=(
  /usr/share/applications
  /usr/local/share/applications
  /var/lib/flatpak/exports/share/applications
  "$HOME/.local/share/applications"
)

find_apps() {
  local desktop_files=()
  for dir in "${DIRS[@]}"; do
    [[ -d "$dir" ]] && desktop_files+=("$dir"/*.desktop)
  done

  (( ${#desktop_files[@]} == 0 )) && return 1

  awk -F'=' '
    /^Name=/ { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); name = $2 }
    /^Exec=/ { if (name) { print name "\t" $2; name = "" } }
  ' "${desktop_files[@]}" | sort -u
}

fzf_drun() {
  local selected exec_cmd

  selected=$(find_apps | fzf \
    --prompt="; " \
    --delimiter='\t' \
    --with-nth='{1}')

  [[ -z "$selected" ]] && return 0

  exec_cmd=$(echo "$selected" | awk -F'\t' '{print $2}')

  [[ -z "$exec_cmd" ]] && return 1

  exec_cmd=$(echo "$exec_cmd" | sed -E 's/%[fFuUdDnNiIcCkKvVmM]//g')

  swaymsg exec -- "$exec_cmd" >/dev/null 2>&1
}

fzf_drun
